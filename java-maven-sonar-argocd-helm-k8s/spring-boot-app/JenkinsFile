pipeline {
    // Run the overall pipeline on the base Jenkins executor (the host VM/Node)
    // Assumes 'docker' and 'git' CLIs are installed on the Jenkins host machine.
    agent any

    stages {
        stage('Checkout') {
            steps {
                sh 'echo Repository checked out successfully on the host machine'
            }
        }
        
        stage('Build and Test') {
            steps {
                // Ensure clean state on host before running container to avoid file locks
                sh 'rm -rf java-maven-sonar-argocd-helm-k8s/spring-boot-app/target'

                script {
                    // This uses the maven container to run mvn commands
                    docker.image('maven:3.9.6-eclipse-temurin-17').inside {
                        sh 'ls -ltr'
                        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
                    }
                }
            }
        }

        stage('Static Code Analysis') {
            environment {
                // IMPORTANT: Ensure this IP is correct and reachable from your Jenkins host/network
                SONAR_HOST_URL = 'http://100.30.218.158:9000' 
            }
            steps {
                script {
                    // Run Sonar analysis inside the Maven container environment
                    docker.image('maven:3.9.6-eclipse-temurin-17').inside {
                        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                            // Command consolidated to a single line for compatibility
                            sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn org.sonarsource.scanner.maven:sonar-maven-plugin:4.0.0.4121:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=$SONAR_HOST_URL'
                        }
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "abhishekf5/ultimate-cicd:${BUILD_NUMBER}"
            }
            steps {
                script {
                    // Use the built-in Jenkins Docker DSL for building/pushing images, runs on the 'agent any' host
                    def dockerImage = docker.build("${DOCKER_IMAGE}", "java-maven-sonar-argocd-helm-k8s/spring-boot-app")

                    docker.withRegistry('index.docker.io', "docker-cred") {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
                GIT_USER_NAME = "praveenchands065"
            }
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                    git config user.email "praveenchands065@gmail.com"
                    git config user.name "praveenchands065"
                    
                    BUILD_ID_TAG="${BUILD_NUMBER}" 
                    sed -i "s/replaceImageTag/${BUILD_ID_TAG}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    
                    git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                    
                    git push https://${GITHUB_TOKEN}@github.com{GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                    '''
                }
            }
        }
    }
}







